#!/bin/sh
#SBATCH -A ees240003
#SBATCH --ntasks={{ ntasks }}
#SBATCH --nodes={{ nodes }}
#SBATCH --time={{ walltime }}
#SBATCH -p {{ queue }}
#SBATCH --mail-type=BEGIN
#SBATCH --mail-type=END
#SBATCH --mail-type=FAIL
#SBATCH --output=pism.%j

module list

umask 007

cd $SLURM_SUBMIT_DIR

# Generate a list of compute node hostnames reserved for this job,
# this ./nodes file is necessary for slurm to spawn mpi processes
# across multiple compute nodes
srun -l /bin/hostname | sort -n | awk '{{print $2}}' > ./nodes_$SLURM_JOBID

ulimit -l unlimited
ulimit -s unlimited
ulimit

# Abort on the first failing leg. Without this a leg that dies still leaves
# the next one to start on a missing input file — and pismi, whose Python
# driver has no top-level catch, then deadlocks in MPI_Finalize and holds
# the nodes until the job is cancelled.
set -e

module purge
module load intel/2024.1 impi/2021.12

# Honour a container passed in from the submitting environment
# (``container=/path/to/other.sif sbatch this_script.sh``); SLURM's default
# --export=ALL carries it into the job. Falls back to the usual image.
export container="${container:-$HOME/pism.sif}"
if [ ! -f "${container}" ]; then
    echo "Container ${container} not found." >&2
    echo "Override it with: container=/path/to/image.sif sbatch <this script>" >&2
    exit 1
fi
echo "Using container ${container}"

umask 007

cd $SLURM_SUBMIT_DIR

# conda's udunits2/libz activation hooks export host paths that are invalid
# inside the apptainer container (=> "ut_read_xml() failed"). Drop them so the
# container uses its own udunits2.xml. Keeps working even if the env is active.
unset UDUNITS2_XML_PATH UDUNITS2_XML_DIR LD_PRELOAD

ulimit -l unlimited || true
ulimit -s unlimited || true
ulimit

{% if output_dirs %}
# Output directories. A run staged through S3 arrives without them (a bucket
# keeps no empty directories) and PISM does not create them itself.
mkdir -p {{ output_dirs | join(" ") }}
{% endif %}


# Spread PISM's output over several OSTs before anything is written. On
# chinook's Lustre this does not make writes faster, but it stops a single
# writer's throughput from depending on which OST it happened to land on:
# see docs/source/developer/lustre_striping.md. Two subtleties —
# ``{{ output_path }}`` is the *logs* directory (the templates use it for
# --output= above) and the output tree is its sibling; and the run's
# subdirectories already exist, having been created when this script was
# rendered, so each needs its own layout rather than inheriting one set on
# the parent. Inert where there is no Lustre client.
command -v lfs >/dev/null 2>&1 && find "$(dirname "{{ output_path }}")/output" -type d \
    -exec lfs setstripe -c 8 {} \; 2>/dev/null || true

pismtasks=$(( SLURM_NTASKS - 4 ))

{% if run_init_str %}
# ###############################################################################
# INIT RUN
# ###############################################################################

mpiexec -n 1  apptainer run ${container} pism_async_writer -f : -n ${pismtasks} apptainer run ${container} pism {{ run_init_str }} -output.asynchronous
{% endif %}

{% if inv_str %}
# ###############################################################################
# INVERSION RUN
# ###############################################################################

mpiexec -n  ${SLURM_NTASKS} apptainer run  ${container} pismi {{ inv_str }}
{% endif %}

{% if run_str %}
# ###############################################################################
# FORWARD RUN
# ###############################################################################

mpiexec -n 1  apptainer run ${container} pism_async_writer -f : -n ${pismtasks} apptainer run ${container} pism {{ run_str }} -output.asynchronous
{% endif %}

{% if post_process_str %}
# ###############################################################################
# POSTPROCESSING RUN
# ###############################################################################

{{ post_process_str }}
{% endif %}

{% if dh_str %}
# ###############################################################################
# DH POSTPROCESSING RUN
# ###############################################################################

{{ dh_str }}
{% endif %}
