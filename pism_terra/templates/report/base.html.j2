<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }} &mdash; {{ title }}</title>
<link rel="stylesheet" href="_static/report.css">
</head>
<body>
<header class="bd-header">
  <a href="index.html"><img class="logo" src="_static/{{ logo_name }}" alt="Snow4Flow"></a>
  <div>
    <div class="title">{{ title }}</div>
    <div class="subtitle">{{ run_dir }}</div>
  </div>
</header>
<div class="bd-container">
  <nav class="bd-sidebar-primary">
    <h3>Report</h3>
    <ul>
      {% for item in nav %}
      <li><a href="{{ item.href }}"{% if item.href == current %} class="active"{% endif %}>{{ item.label }}</a></li>
      {% if item.href == current and sections %}
        {% for s in sections %}<li class="sub"><a href="#{{ s.id }}">{{ s.label }}</a></li>{% endfor %}
      {% endif %}
      {% endfor %}
    </ul>
    <h3>Generated</h3>
    <p class="meta">{{ generated }}<br>pism-terra {{ version }}</p>
  </nav>
  <main class="bd-main">
{% block content %}{% endblock %}
  </main>
</div>
<footer class="bd-footer">Generated by <code>pism-s4f-report</code> on {{ generated }} &middot; Snow4Flow &middot; U Arizona &bull; NASA</footer>
</body>
</html>
